{
  "name": "oopz-live-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/App.tsx\" \"src/main.tsx\" \"src/pages/**/*.tsx\" \"src/components/**/*.tsx\" \"src/hooks/**/*.ts\" \"src/services/**/*.ts\" \"src/utils/**/*.ts\" \"src/styles/**/*.css\" \"test/**/*.ts\" \"eslint.config.js\" \"vitest.config.ts\"",
    "format:check": "prettier --check \"src/App.tsx\" \"src/main.tsx\" \"src/pages/**/*.tsx\" \"src/components/**/*.tsx\" \"src/hooks/**/*.ts\" \"src/services/**/*.ts\" \"src/utils/**/*.ts\" \"src/styles/**/*.css\" \"test/**/*.ts\" \"eslint.config.js\" \"vitest.config.ts\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vidstack": "^0.6.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "@eslint/js": "^9.24.0",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1",
    "prettier": "^3.5.3",
    "eslint": "^9.24.0"
  }
}

